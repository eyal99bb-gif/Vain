# MIDA environment — all optional. Missing vars activate demo mode:
#   no GEMINI_API_KEY  -> canned avatar/try-on images (demo AI)
#   no DATABASE_URL    -> JSON file persistence under MIDA_DATA_DIR
#   no S3_*            -> images stored on local disk under MIDA_DATA_DIR/uploads

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-flash-latest

# Postgres (e.g. Neon). Tables are created automatically on first use;
# DATABASE_URL and POSTGRES_URL (set by Vercel's Neon integration) both work.
DATABASE_URL=

# Image storage picks the first available: Blob -> S3 -> Postgres -> local disk.
# When DATABASE_URL/POSTGRES_URL is set, images are stored in Postgres
# (mida_files table) and none of the below are needed.

# Vercel Blob storage (optional; set automatically when a Blob store is
# connected to the Vercel project). Takes precedence over S3/Postgres.
BLOB_READ_WRITE_TOKEN=

# S3-compatible storage (e.g. Cloudflare R2)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional public/CDN base URL for stored objects
S3_PUBLIC_URL=

# Local data directory for demo persistence + local uploads
MIDA_DATA_DIR=.data
